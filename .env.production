# Production Environment Configuration
# Use environment variable injection in production
# Never commit actual secrets to version control

# ============ Database ============
DATABASE_URL=${DATABASE_URL}
# Example: postgresql://user:password@host:5432/brainimation

# ============ Server ============
PORT=${PORT:-5001}
NODE_ENV=production
HOST=0.0.0.0

# ============ Client ============
VITE_API_URL=${VITE_API_URL:-https://api.brainimation.com}

# ============ Security ============
SESSION_SECRET=${SESSION_SECRET}
# Generate with: openssl rand -base64 32
JWT_SECRET=${JWT_SECRET}
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=${ENCRYPTION_KEY}
# Generate with: openssl rand -hex 32

# ============ External Services ============
OPENAI_API_KEY=${OPENAI_API_KEY}
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
GOOGLE_ANALYTICS_ID=${GOOGLE_ANALYTICS_ID}
SENTRY_DSN=${SENTRY_DSN}

# ============ Email Service ============
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
MAIL_FROM=${MAIL_FROM:-noreply@brainimation.com}

# ============ Redis Cache ============
REDIS_URL=${REDIS_URL}
# Example: redis://host:6379

# ============ Monitoring & Logging ============
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090

# ============ Feature Flags ============
ENABLE_MOCK_DATA=false
ENABLE_OFFLINE_MODE=true
ENABLE_VOICE_AGENT=true
ENABLE_COMMUNITY=true

# ============ Rate Limiting ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ============ Session Configuration ============
SESSION_MAX_AGE=604800000
SESSION_SECURE=true
SESSION_SAME_SITE=strict

# ============ CORS ============
CORS_ORIGIN=https://brainimation.com,https://app.brainimation.com

# ============ API Configuration ============
API_TIMEOUT=30000
API_MAX_REQUEST_SIZE=10mb

# ============ Database Pool ============
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# ============ AWS/Cloud Provider (if applicable) ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
S3_BUCKET=${S3_BUCKET}

# ============ Backup Configuration ============
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://brainimation-backups

# ============ Timezone ============
TZ=UTC

