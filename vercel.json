{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "functions": {
    "dist/index.cjs": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "dist/index.cjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
